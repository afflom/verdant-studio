{"evidence": {"identity": {"agent": "afflom", "artifact": "docs/owner-decisions.md"}}, "id": "REQ-OBSERVABILITY", "stakeholder": "afflom", "statement": "Every operation of Verdant Studio is observable, auditable and traceable in its own runtime (REQ-SELF-RUNTIME): each emits its OpenTelemetry signals, a span, log records and metrics in OTLP/JSON, correlated by W3C Trace Context and attributed to the acting Prism ID, so that logging and metrics record every operation and every refusal, each refusal is the error from which REQ-SELF-HEALING takes its observation, and the log records are the audit trail of who did what, when and with which result."}
{"construct": "Studio.Telemetry", "req": "REQ-OBSERVABILITY"}
{"construct": "Studio.Telemetry.Context", "std": {"authority": "W3C-TRACE-CONTEXT-1"}}
{"construct": "Studio.Telemetry.Span", "std": {"authority": "OTEL-SPEC-1.60.0-TRACE-API", "row": "W04"}}
{"construct": "Studio.Telemetry.Run", "std": {"authority": "OTEL-SEMCONV-1.37.0-CICD-SPANS"}}
{"construct": "Studio.Telemetry.Log", "std": {"authority": "OTEL-SPEC-1.60.0-LOGS-DATA-MODEL", "row": "W04"}}
{"construct": "Studio.Telemetry.Metric", "std": {"authority": "OTEL-SPEC-1.60.0-METRICS-DATA-MODEL", "row": "W04"}}
{"construct": "Studio.Telemetry.RunMetric", "std": {"authority": "OTEL-SEMCONV-1.37.0-CICD-METRICS"}}
{"construct": "Studio.Telemetry.Error", "std": {"authority": "OTEL-SEMCONV-1.37.0-ERROR"}}
{"construct": "Studio.Telemetry.Resource", "std": {"authority": "OTEL-SEMCONV-1.37.0-SERVICE"}}
{"construct": "Studio.Telemetry.Encoding", "std": {"authority": "OTLP-1.11.1-SPECIFICATION"}}
{"construct": "Studio.Telemetry.Attribution", "der": {"check": "VS-04", "inputs": ["Studio.Telemetry", "Studio.Agent.PrismId", "Studio.Observer"], "rule": "pattern"}}
{"construct": "Studio.Telemetry.Audit", "std": {"authority": "ISO-IEC-27002-2022-PREVIEW", "row": "T06"}}
{"construct": "Studio.Telemetry.Indicator", "std": {"authority": "GOOGLE-SRE-BOOK-CH4-SLO", "row": "W01"}}
{"construct": "Studio.Telemetry.Healing", "der": {"check": "VS-04", "inputs": ["Studio.Telemetry.Log", "Studio.Telemetry.Error", "Studio.Error.Observation", "Studio.SelfHealing"], "rule": "pattern"}}
