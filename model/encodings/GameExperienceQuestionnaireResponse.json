{"name":"game-experience-questionnaire-response","schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"Game Experience Questionnaire item response","$comment":"GEQ (IJsselsteijn, de Kort, Poels 2013): modules and components from section 6 Scoring guidelines; scale 0 (not at all) to 4 (extremely) from sections 2-5","$defs":{"geq-module":{"title":"GEQ module","enum":["Core Module","In-Game version","Social Presence Module","Post-game Module"]},"geq-component":{"title":"GEQ component","enum":["Competence","Sensory and Imaginative Immersion","Flow","Tension/Annoyance","Challenge","Negative affect","Positive affect","Tension","Psychological Involvement – Empathy","Psychological Involvement – Negative Feelings","Behavioural Involvement","Positive Experience","Negative experience","Tiredness","Returning to Reality"]},"geq-scale-label":{"title":"GEQ scale label","enum":["not at all","slightly","moderately","fairly","extremely"]}},"type":"object","additionalProperties":false,"required":["module","item","score"],"properties":{"module":{"$ref":"#/$defs/geq-module"},"item":{"type":"integer","minimum":1},"score":{"type":"integer","minimum":0,"maximum":4}}},"citation":["std","IJSSELSTEIJN-GEQ-2013","L06"]}
